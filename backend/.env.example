# Copy to .env and fill in. NEVER commit .env to git.
APP_ENV=development            # development | production | testing
SECRET_KEY=change-me-to-32plus-random-chars   # required in production

# MongoDB Atlas (free M0 is fine for dev). Least-privilege app user, readWrite on ragnosis only.
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true
MONGO_DB=ragnosis

# Auth
JWT_ACCESS_MINUTES=30         # 15-60 per spec
JWT_REFRESH_DAYS=7
BCRYPT_ROUNDS=12

# Frontend origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173

# External AI services
GROQ_API_KEY=

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

LOG_LEVEL=INFO
RATELIMIT_DEFAULT=300 per minute
